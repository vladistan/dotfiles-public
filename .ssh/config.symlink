# DevPod Start global.devpod
Host global.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/Applications/DevPod.app/Contents/MacOS/devpod-cli" ssh --stdio --context default --user codespace global
  User codespace
# DevPod End global.devpod
Host wspace1
        User codespace
        ProxyCommand /usr/local/bin/gh cs ssh -c zany-space-guacamole-6pw7wr99hrvjp --stdio -- -i /Users/vlad/.ssh/codespaces.auto
        UserKnownHostsFile=/dev/null
        StrictHostKeyChecking no
        LogLevel quiet
        ControlMaster auto
        IdentityFile /Users/vlad/.ssh/codespaces.auto

# DevPod Start devpod-go-1.devpod
Host devpod-go-1.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/Applications/DevPod.app/Contents/MacOS/devpod-cli" ssh --stdio --context default --user vscode devpod-go-1
  User vscode
# DevPod End devpod-go-1.devpod
# DevPod Start t1.devpod
Host t1.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/Applications/DevPod.app/Contents/MacOS/devpod-cli" ssh --stdio --context default --user vscode t1
  User vscode
# DevPod End t1.devpod
# --- START CODER VSCODE rgsfacvt56ob4.pit-1.try.coder.app ---
Host coder-vscode.rgsfacvt56ob4.pit-1.try.coder.app--*
  ConnectTimeout 0
  LogLevel ERROR
  ProxyCommand "/Users/vlad/Library/Application Support/Code/User/globalStorage/coder.coder-remote/rgsfacvt56ob4.pit-1.try.coder.app/bin/coder-darwin-amd64" --global-config "/Users/vlad/Library/Application Support/Code/User/globalStorage/coder.coder-remote/rgsfacvt56ob4.pit-1.try.coder.app" ssh --stdio --usage-app=vscode --disable-autostart --network-info-dir "/Users/vlad/Library/Application Support/Code/User/globalStorage/coder.coder-remote/net" --ssh-host-prefix coder-vscode.rgsfacvt56ob4.pit-1.try.coder.app-- %h
  SetEnv  CODER_SSH_SESSION_TYPE=vscode
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
# --- END CODER VSCODE rgsfacvt56ob4.pit-1.try.coder.app ---

Host pve* !*.* !*-*.*
    User root
