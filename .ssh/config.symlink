Include conf.d/*.config

# DevPod Start hplc-lims-go-client.devpod
Host hplc-lims-go-client.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/Applications/DevPod.app/Contents/MacOS/devpod-cli" ssh --stdio --context default --user codespace hplc-lims-go-client
  User codespace
# DevPod End hplc-lims-go-client.devpod
# DevPod Start vscode-remote-try-go.devpod
Host vscode-remote-try-go.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/Applications/DevPod.app/Contents/MacOS/devpod-cli" ssh --stdio --context default --user vscode vscode-remote-try-go
  User vscode
# DevPod End vscode-remote-try-go.devpod
